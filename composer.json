{
    "name": "visuellverstehen/statamic-glossary-tooltips",
    "description": "Provides glossary tooltips for your bard content.",
    "keywords": [
        "statamic",
        "addon",
        "tooltips",
        "glossary",
        "terms",
        "bard",
        "v6"
    ],
    "type": "statamic-addon",
    "autoload": {
        "psr-4": {
            "VV\\GlossaryTooltips\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VV\\GlossaryTooltips\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "visuellverstehen"
        }
    ],
    "support": {
        "email": "hello@visuellverstehen.de"
    },
    "extra": {
        "statamic": {
            "name": "Statamic Glossary Tooltips",
            "description": "Statamic Glossary Tooltips addon"
        },
        "laravel": {
            "providers": [
                "VV\\GlossaryTooltips\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": false,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    }
}
